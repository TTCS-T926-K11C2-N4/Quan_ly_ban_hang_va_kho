<%@ page pageEncoding="UTF-8" %>
<%-- Trang include cần đặt activeMenu: dashboard | accounts | sales | products | suppliers | warehouse | reports | profile.
     S1-06: mục menu chỉ hiện khi có quyền xem module đó; quyền còn được kiểm lại ở AuthFilter. --%>
<aside class="app-sidebar" id="app-sidebar">
    <div class="app-sidebar__brand">
        <img class="app-sidebar__logo" src="<c:url value='/assets/img/logo.png'/>" alt="" width="63" height="63">
        <div>
            <p class="app-sidebar__brand-title">BÁN HÀNG &amp; KHO</p>
            <p class="app-sidebar__brand-subtitle">Hệ thống quản lý</p>
        </div>
    </div>

    <nav class="app-menu" aria-labelledby="app-menu-title">
        <p class="app-menu__title" id="app-menu-title">MENU CHỨC NĂNG</p>
        <ul class="app-menu__list">
            <li>
                <a class="app-menu__link${activeMenu == 'dashboard' ? ' app-menu__link--active' : ''}" id="menu-dashboard"
                   href="<c:url value='${currentUser.homePath}'/>"${activeMenu == 'dashboard' ? ' aria-current="page"' : ''}>
                    <span class="app-menu__icon app-menu__icon--dashboard" aria-hidden="true"></span>${currentUser.customer ? 'Trang chủ' : 'Tổng quan'}
                </a>
            </li>
            <c:if test="${currentUser.customer and currentUser.can('ORDER_MANAGE')}">
            <li>
                <a class="app-menu__link${activeMenu == 'portal-order-new' ? ' app-menu__link--active' : ''}" id="menu-portal-order-new"
                   href="<c:url value='/portal/order/new'/>"${activeMenu == 'portal-order-new' ? ' aria-current="page"' : ''}>
                    <span class="app-menu__icon app-menu__icon--sales" aria-hidden="true"></span>Đặt hàng
                </a>
            </li>
            </c:if>
            <c:if test="${currentUser.customer and currentUser.can('ORDER_VIEW')}">
            <li>
                <a class="app-menu__link${activeMenu == 'portal-orders' ? ' app-menu__link--active' : ''}" id="menu-portal-orders"
                   href="<c:url value='/portal/orders'/>"${activeMenu == 'portal-orders' ? ' aria-current="page"' : ''}>
                    <span class="app-menu__icon app-menu__icon--sales" aria-hidden="true"></span>Đơn hàng của tôi
                </a>
            </li>
            </c:if>
            <c:if test="${currentUser.can('USER_VIEW') or currentUser.can('AUDIT_LOG_VIEW') or (currentUser.can('CUSTOMER_VIEW') and not currentUser.customer)}">
            <li>
                <%-- Giống nhóm Sản phẩm; trang đặt activeSubmenu: account-list | audit-logs | customers | assignments.
                     Đại lý nằm trong nhóm này theo thiết kế S3-05/S3-07 (Quản lý tài khoản / Đại lý) --%>
                <details class="app-menu__group"${activeMenu == 'accounts' ? ' open' : ''}>
                <summary class="app-menu__link app-menu__toggle${activeMenu == 'accounts' ? ' app-menu__toggle--current' : ''}" id="menu-accounts">
                    <span class="app-menu__icon app-menu__icon--accounts" aria-hidden="true"></span>Quản lý tài khoản
                    <span class="app-menu__chevron" aria-hidden="true"></span>
                </summary>
                <ul class="app-submenu">
                    <c:if test="${currentUser.can('USER_VIEW')}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'account-list' ? ' app-submenu__link--active' : ''}" id="menu-account-list"
                           href="<c:url value='/accounts'/>"${activeSubmenu == 'account-list' ? ' aria-current="page"' : ''}>Danh sách tài khoản</a>
                    </li>
                    </c:if>
                    <c:if test="${currentUser.can('CUSTOMER_VIEW') and not currentUser.customer}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'customers' ? ' app-submenu__link--active' : ''}" id="menu-customers"
                           href="<c:url value='/customers'/>"${activeSubmenu == 'customers' ? ' aria-current="page"' : ''}>Đại lý</a>
                    </li>
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'assignments' ? ' app-submenu__link--active' : ''}" id="menu-assignments"
                           href="<c:url value='/customers/assignments'/>"${activeSubmenu == 'assignments' ? ' aria-current="page"' : ''}>Phân công kinh doanh</a>
                    </li>
                    </c:if>
                    <c:if test="${currentUser.can('AUDIT_LOG_VIEW')}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'audit-logs' ? ' app-submenu__link--active' : ''}" id="menu-audit-logs"
                           href="<c:url value='/audit-logs'/>"${activeSubmenu == 'audit-logs' ? ' aria-current="page"' : ''}>Nhật ký thao tác</a>
                    </li>
                    </c:if>
                </ul>
                </details>
            </li>
            </c:if>
            <c:if test="${currentUser.can('ORDER_VIEW')}">
            <li>
                <%-- Nhóm Bán hàng: Danh sách đơn hàng (S4-07) và Tạo đơn hàng (S3-09, cần quyền tạo đơn);
                     trang đặt activeSubmenu: order-list | order-new --%>
                <details class="app-menu__group"${activeMenu == 'sales' ? ' open' : ''}>
                <summary class="app-menu__link app-menu__toggle${activeMenu == 'sales' ? ' app-menu__toggle--current' : ''}" id="menu-sales">
                    <span class="app-menu__icon app-menu__icon--sales" aria-hidden="true"></span>Bán hàng
                    <span class="app-menu__chevron" aria-hidden="true"></span>
                </summary>
                <ul class="app-submenu">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'order-list' ? ' app-submenu__link--active' : ''}" id="menu-order-list"
                           href="<c:url value='/orders'/>"${activeSubmenu == 'order-list' ? ' aria-current="page"' : ''}>Danh sách đơn hàng</a>
                    </li>
                    <c:if test="${currentUser.can('ORDER_MANAGE') and not currentUser.customer}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'order-new' ? ' app-submenu__link--active' : ''}" id="menu-order-new"
                           href="<c:url value='/orders/new'/>"${activeSubmenu == 'order-new' ? ' aria-current="page"' : ''}>Tạo đơn hàng</a>
                    </li>
                    </c:if>
                </ul>
                </details>
            </li>
            </c:if>
            <c:if test="${currentUser.can('ORDER_APPROVAL_VIEW')}">
            <li>
                <%-- Duyệt đơn vượt hạn mức / dưới giá sàn (S4-05); số đếm do ApprovalBadgeFilter đặt khi mở trang --%>
                <a class="app-menu__link${activeMenu == 'approvals' ? ' app-menu__link--active' : ''}" id="menu-approvals"
                   href="<c:url value='/approvals'/>"${activeMenu == 'approvals' ? ' aria-current="page"' : ''}>
                    <span class="app-menu__icon app-menu__icon--approvals" aria-hidden="true"></span>Duyệt đơn
                    <c:if test="${pendingApprovalCount > 0}">
                        <span class="app-menu__count" aria-label="${pendingApprovalCount} đơn chờ duyệt">${pendingApprovalCount > 99 ? '99+' : pendingApprovalCount}</span>
                    </c:if>
                </a>
            </li>
            </c:if>
            <c:if test="${currentUser.can('PRODUCT_VIEW')}">
            <li>
                <%-- Menu cha chỉ mở/đóng menu con (details/summary, không cần JS); đang ở trang thuộc Sản phẩm thì mở sẵn.
                     Trang đặt activeSubmenu: product-list | categories --%>
                <details class="app-menu__group"${activeMenu == 'products' ? ' open' : ''}>
                <summary class="app-menu__link app-menu__toggle${activeMenu == 'products' ? ' app-menu__toggle--current' : ''}" id="menu-products">
                    <span class="app-menu__icon app-menu__icon--products" aria-hidden="true"></span>Sản phẩm
                    <span class="app-menu__chevron" aria-hidden="true"></span>
                </summary>
                <ul class="app-submenu">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'product-list' ? ' app-submenu__link--active' : ''}" id="menu-product-list"
                           href="<c:url value='/products'/>"${activeSubmenu == 'product-list' ? ' aria-current="page"' : ''}>Danh sách sản phẩm</a>
                    </li>
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'categories' ? ' app-submenu__link--active' : ''}" id="menu-categories"
                           href="<c:url value='/categories'/>"${activeSubmenu == 'categories' ? ' aria-current="page"' : ''}>Nhóm hàng</a>
                    </li>
                    <c:if test="${not currentUser.customer}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'units' ? ' app-submenu__link--active' : ''}" id="menu-units"
                           href="<c:url value='/units'/>"${activeSubmenu == 'units' ? ' aria-current="page"' : ''}>Đơn vị tính</a>
                    </li>
                    </c:if>
                    <%-- Đại lý có PRODUCT_VIEW nhưng không xem bảng giá các nhóm (PriceListListServlet) --%>
                    <c:if test="${not currentUser.customer}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'price-lists' ? ' app-submenu__link--active' : ''}" id="menu-price-lists"
                           href="<c:url value='/price-lists'/>"${activeSubmenu == 'price-lists' ? ' aria-current="page"' : ''}>Bảng giá</a>
                    </li>
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'discount-policies' ? ' app-submenu__link--active' : ''}" id="menu-discount-policies"
                           href="<c:url value='/discount-policies'/>"${activeSubmenu == 'discount-policies' ? ' aria-current="page"' : ''}>Chính sách chiết khấu</a>
                    </li>
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'price-history' ? ' app-submenu__link--active' : ''}" id="menu-price-history"
                           href="<c:url value='/price-history'/>"${activeSubmenu == 'price-history' ? ' aria-current="page"' : ''}>Lịch sử thay đổi giá</a>
                    </li>
                    </c:if>
                </ul>
                </details>
            </li>
            </c:if>
            <c:if test="${currentUser.can('INVENTORY_VIEW')}">
            <li>
                <a class="app-menu__link${activeMenu == 'suppliers' ? ' app-menu__link--active' : ''}" id="menu-suppliers"
                   href="<c:url value='/suppliers'/>"${activeMenu == 'suppliers' ? ' aria-current="page"' : ''}>
                    <span class="app-menu__icon app-menu__icon--suppliers" aria-hidden="true"></span>Nhà cung cấp
                </a>
            </li>
            <li>
                <%-- Nhóm Kho hàng (EP-05, thiết kế Sprint 5); trang đặt activeSubmenu:
                     warehouses (S5-03) | goods-receipts (S5-04) | stock (S5-05) | reservations (S5-06) |
                     pick-lists (S6-03, S6-05) | deliveries (S6-08).
                     Mỗi mục chỉ hiện khi ứng dụng đã có Servlet của màn đó (tên đăng ký mặc định của @WebServlet là
                     tên đầy đủ của lớp), để merge lẻ từng story không hiện mục dẫn tới trang chưa có --%>
                <c:set var="servlets" value="${pageContext.servletContext.servletRegistrations}"/>
                <details class="app-menu__group"${activeMenu == 'warehouse' ? ' open' : ''}>
                <summary class="app-menu__link app-menu__toggle${activeMenu == 'warehouse' ? ' app-menu__toggle--current' : ''}" id="menu-warehouse">
                    <span class="app-menu__icon app-menu__icon--warehouse" aria-hidden="true"></span>Kho hàng
                    <span class="app-menu__chevron" aria-hidden="true"></span>
                </summary>
                <ul class="app-submenu">
                    <c:if test="${not empty servlets['com.oms.controller.WarehouseListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'warehouses' ? ' app-submenu__link--active' : ''}" id="menu-warehouses"
                           href="<c:url value='/warehouses'/>"${activeSubmenu == 'warehouses' ? ' aria-current="page"' : ''}>Danh sách kho</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.GoodsReceiptListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'goods-receipts' ? ' app-submenu__link--active' : ''}" id="menu-goods-receipts"
                           href="<c:url value='/goods-receipts'/>"${activeSubmenu == 'goods-receipts' ? ' aria-current="page"' : ''}>Phiếu nhập kho</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.TransferListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'transfers' ? ' app-submenu__link--active' : ''}" id="menu-transfers"
                           href="<c:url value='/transfers'/>"${activeSubmenu == 'transfers' ? ' aria-current="page"' : ''}>Chuyển kho</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.StockLedgerServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'stock' ? ' app-submenu__link--active' : ''}" id="menu-stock"
                           href="<c:url value='/stock'/>"${activeSubmenu == 'stock' ? ' aria-current="page"' : ''}>Sổ tồn kho</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.StocktakeListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'stocktakes' ? ' app-submenu__link--active' : ''}" id="menu-stocktakes"
                           href="<c:url value='/stocktakes'/>"${activeSubmenu == 'stocktakes' ? ' aria-current="page"' : ''}>Kiểm kê kho</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.ReservationListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'reservations' ? ' app-submenu__link--active' : ''}" id="menu-reservations"
                           href="<c:url value='/stock/reservations'/>"${activeSubmenu == 'reservations' ? ' aria-current="page"' : ''}>Giữ chỗ tồn</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.LotListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'lots' ? ' app-submenu__link--active' : ''}" id="menu-lots"
                           href="<c:url value='/lots'/>"${activeSubmenu == 'lots' ? ' aria-current="page"' : ''}>Lô và hạn dùng</a>
                    </li>
                    </c:if>
                    <%-- Sprint 6: phiếu soạn hàng (S6-03); cần thêm quyền xem giao hàng --%>
                    <c:if test="${currentUser.can('DELIVERY_VIEW') and not empty servlets['com.oms.controller.PickListListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'pick-lists' ? ' app-submenu__link--active' : ''}" id="menu-pick-lists"
                           href="<c:url value='/pick-lists'/>"${activeSubmenu == 'pick-lists' ? ' aria-current="page"' : ''}>Phiếu soạn hàng</a>
                    </li>
                    </c:if>
                    <c:if test="${currentUser.can('DELIVERY_VIEW') and not empty servlets['com.oms.controller.TripListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'trips' ? ' app-submenu__link--active' : ''}" id="menu-trips"
                           href="<c:url value='/trips'/>"${activeSubmenu == 'trips' ? ' aria-current="page"' : ''}>Chuyến giao hàng</a>
                    </li>
                    </c:if>
                    <c:if test="${currentUser.can('DELIVERY_VIEW') and not empty servlets['com.oms.controller.DeliveryListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'deliveries' ? ' app-submenu__link--active' : ''}" id="menu-deliveries"
                           href="<c:url value='/deliveries'/>"${activeSubmenu == 'deliveries' ? ' aria-current="page"' : ''}>Xác nhận giao hàng</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty servlets['com.oms.controller.StockCardServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'stock-card' ? ' app-submenu__link--active' : ''}" id="menu-stock-card"
                           href="<c:url value='/stock/card'/>"${activeSubmenu == 'stock-card' ? ' aria-current="page"' : ''}>Thẻ kho</a>
                    </li>
                    </c:if>
                </ul>
                </details>
            </li>
            </c:if>
            <%-- Hoá đơn & công nợ (EP-07, Sprint 7): trang đặt activeMenu = finance, activeSubmenu: invoices --%>
            <c:if test="${currentUser.can('INVOICE_VIEW') and not currentUser.customer}">
            <li>
                <c:set var="financeServlets" value="${pageContext.servletContext.servletRegistrations}"/>
                <details class="app-menu__group"${activeMenu == 'finance' ? ' open' : ''}>
                <summary class="app-menu__link app-menu__toggle${activeMenu == 'finance' ? ' app-menu__toggle--current' : ''}" id="menu-finance">
                    <span class="app-menu__icon app-menu__icon--reports" aria-hidden="true"></span>Hoá đơn &amp; công nợ
                    <span class="app-menu__chevron" aria-hidden="true"></span>
                </summary>
                <ul class="app-submenu">
                    <c:if test="${not empty financeServlets['com.oms.controller.InvoiceListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'invoices' ? ' app-submenu__link--active' : ''}" id="menu-invoices"
                           href="<c:url value='/invoices'/>"${activeSubmenu == 'invoices' ? ' aria-current="page"' : ''}>Hoá đơn bán hàng</a>
                    </li>
                    </c:if>
                    <c:if test="${not empty financeServlets['com.oms.controller.PaymentListServlet']}">
                    <li>
                        <a class="app-submenu__link${activeSubmenu == 'payments' ? ' app-submenu__link--active' : ''}" id="menu-payments"
                           href="<c:url value='/payments'/>"${activeSubmenu == 'payments' ? ' aria-current="page"' : ''}>Thu tiền</a>
                    </li>
                    </c:if>
                </ul>
                </details>
            </li>
            </c:if>
            <c:if test="${currentUser.can('REPORT_VIEW')}">
            <li>
                <a class="app-menu__link${activeMenu == 'reports' ? ' app-menu__link--active' : ''}" id="menu-reports"
                   href="<c:url value='/reports'/>"${activeMenu == 'reports' ? ' aria-current="page"' : ''}>
                    <span class="app-menu__icon app-menu__icon--reports" aria-hidden="true"></span>Báo cáo
                </a>
            </li>
            </c:if>
        </ul>
    </nav>

    <c:if test="${not empty currentUser}">
        <div class="app-user">
            <div class="app-user__info">
                <c:choose>
                    <c:when test="${not empty currentUser.avatarFileId}">
                        <img class="app-user__avatar" alt="" width="44" height="44"
                             src="<c:url value='/avatar'><c:param name='user' value='${currentUser.id}'/><c:param name='v' value='${currentUser.avatarFileId}'/></c:url>">
                    </c:when>
                    <c:otherwise>
                        <span class="app-user__avatar" aria-hidden="true"><c:out value="${currentUser.initials}"/></span>
                    </c:otherwise>
                </c:choose>
                <div>
                    <p class="app-user__name"><c:out value="${currentUser.fullName}"/></p>
                    <p class="app-user__role"><c:out value="${currentUser.roleName}"/></p>
                    <c:if test="${not empty currentUser.scope}">
                        <p class="app-user__scope"><c:out value="${currentUser.scope}"/></p>
                    </c:if>
                </div>
            </div>
            <div class="app-user__actions">
                <a class="app-user__action${activeMenu == 'profile' ? ' app-user__action--active' : ''}" id="profile-link"
                   href="<c:url value='/profile'/>"${activeMenu == 'profile' ? ' aria-current="page"' : ''}>Hồ sơ</a>
                <a class="app-user__action" id="change-password-link" href="<c:url value='/change-password'/>">Đổi mật khẩu</a>
                <form action="<c:url value='/logout'/>" method="post">
                    <button class="app-user__action" type="submit" id="logout-button">Đăng xuất</button>
                </form>
            </div>
        </div>
    </c:if>
</aside>
<div class="app-sidebar-backdrop" id="app-sidebar-backdrop" hidden></div>
