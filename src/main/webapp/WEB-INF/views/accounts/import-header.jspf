<%@ page pageEncoding="UTF-8" %>
<%-- Đầu trang chung của 3 bước nhập Excel: người dùng (S2-01) và sản phẩm (S2-08). Trang include cần đặt
     importStep (1..3), importSubtitle; trang nhập sản phẩm đặt thêm importType = products. --%>
<header class="page-header import-header">
    <div>
        <h1 class="import-header__title">Import hàng loạt từ Excel</h1>
        <p class="import-header__subtitle"><c:out value="${importSubtitle}"/></p>
    </div>
</header>

<%-- Chỉ hiện tab của loại dữ liệu người dùng được phép nhập; quyền còn được kiểm lại ở AuthFilter --%>
<c:set var="importProducts" value="${importType == 'products'}"/>
<div class="import-tabs" role="tablist" aria-label="Loại dữ liệu nhập">
    <c:if test="${currentUser.can('USER_MANAGE')}">
        <a class="import-tabs__item${importProducts ? '' : ' import-tabs__item--active'}" role="tab" id="import-tab-users"
           aria-selected="${not importProducts}" href="<c:url value='/accounts/import'/>">Import người dùng</a>
    </c:if>
    <c:if test="${currentUser.can('PRODUCT_MANAGE')}">
        <a class="import-tabs__item${importProducts ? ' import-tabs__item--active' : ''}" role="tab" id="import-tab-products"
           aria-selected="${importProducts}" href="<c:url value='/products/import'/>">Import sản phẩm</a>
    </c:if>
</div>

<ol class="import-steps" aria-label="Các bước nhập">
    <li class="import-steps__item${importStep > 1 ? ' import-steps__item--done' : importStep == 1 ? ' import-steps__item--current' : ''}"
        ${importStep == 1 ? 'aria-current="step"' : ''}>
        <span class="import-steps__number" aria-hidden="true">${importStep > 1 ? '✓' : '1'}</span>
        <span class="import-steps__text">
            <strong class="import-steps__label">Tải file</strong>
            <span class="import-steps__hint">${importStep > 1 ? 'Đã hoàn thành' : 'Chọn file Excel'}</span>
        </span>
    </li>
    <li class="import-steps__line${importStep > 1 ? ' import-steps__line--done' : ''}" aria-hidden="true"></li>
    <li class="import-steps__item${importStep > 2 ? ' import-steps__item--done' : importStep == 2 ? ' import-steps__item--current' : ''}"
        ${importStep == 2 ? 'aria-current="step"' : ''}>
        <span class="import-steps__number" aria-hidden="true">${importStep > 2 ? '✓' : '2'}</span>
        <span class="import-steps__text">
            <strong class="import-steps__label">Xem trước dữ liệu</strong>
            <span class="import-steps__hint">${importStep > 2 ? 'Đã kiểm tra' : 'Kiểm tra dữ liệu'}</span>
        </span>
    </li>
    <li class="import-steps__line${importStep > 2 ? ' import-steps__line--done' : ''}" aria-hidden="true"></li>
    <li class="import-steps__item${importStep == 3 ? ' import-steps__item--current' : ''}"
        ${importStep == 3 ? 'aria-current="step"' : ''}>
        <span class="import-steps__number" aria-hidden="true">3</span>
        <span class="import-steps__text">
            <strong class="import-steps__label">Kết quả</strong>
            <span class="import-steps__hint">Hoàn tất import</span>
        </span>
    </li>
</ol>
