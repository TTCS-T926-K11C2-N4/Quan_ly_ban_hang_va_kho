<%@ page pageEncoding="UTF-8" %>
<%-- Chuyển giữa các màn của Chi tiết đại lý; trang include đặt customerTab: profile | credit-limit | block | delivery.
     Mỗi màn một thẻ có icon, tiêu đề và mô tả ngắn; màu thẻ theo từng màn (customers.css, .customer-tabs__link--*) --%>
<nav class="customer-tabs" aria-label="Chi tiết đại lý">
    <a class="customer-tabs__link customer-tabs__link--profile${customerTab == 'profile' ? ' customer-tabs__link--active' : ''}"
       href="<c:url value='/customers/profile'><c:param name='id' value='${customer.id}'/></c:url>"${customerTab == 'profile' ? ' aria-current="page"' : ''}>
        <span class="customer-tabs__icon" aria-hidden="true"></span>
        <span class="customer-tabs__text">
            <span class="customer-tabs__title">Hồ sơ</span>
            <span class="customer-tabs__desc">Thông tin đại lý</span>
        </span>
        <span class="customer-tabs__chevron" aria-hidden="true"></span>
    </a>
    <a class="customer-tabs__link customer-tabs__link--credit${customerTab == 'credit-limit' ? ' customer-tabs__link--active' : ''}"
       href="<c:url value='/customers/credit-limit'><c:param name='id' value='${customer.id}'/></c:url>"${customerTab == 'credit-limit' ? ' aria-current="page"' : ''}>
        <span class="customer-tabs__icon" aria-hidden="true"></span>
        <span class="customer-tabs__text">
            <span class="customer-tabs__title">Hạn mức công nợ</span>
            <span class="customer-tabs__desc">Hạn mức và công nợ hiện tại</span>
        </span>
        <span class="customer-tabs__chevron" aria-hidden="true"></span>
    </a>
    <a class="customer-tabs__link customer-tabs__link--block${customerTab == 'block' ? ' customer-tabs__link--active' : ''}"
       href="<c:url value='/customers/block'><c:param name='id' value='${customer.id}'/></c:url>"${customerTab == 'block' ? ' aria-current="page"' : ''}>
        <span class="customer-tabs__icon" aria-hidden="true"></span>
        <span class="customer-tabs__text">
            <span class="customer-tabs__title">Khoá/mở giao dịch</span>
            <span class="customer-tabs__desc">Trạng thái giao dịch</span>
        </span>
        <span class="customer-tabs__chevron" aria-hidden="true"></span>
    </a>
    <a class="customer-tabs__link customer-tabs__link--delivery${customerTab == 'delivery' ? ' customer-tabs__link--active' : ''}"
       href="<c:url value='/customers/delivery-addresses'><c:param name='id' value='${customer.id}'/></c:url>"${customerTab == 'delivery' ? ' aria-current="page"' : ''}>
        <span class="customer-tabs__icon" aria-hidden="true"></span>
        <span class="customer-tabs__text">
            <span class="customer-tabs__title">Điểm giao hàng</span>
            <span class="customer-tabs__desc">Địa chỉ và khu vực giao hàng</span>
        </span>
        <span class="customer-tabs__chevron" aria-hidden="true"></span>
    </a>
</nav>
